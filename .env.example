# Public browser configuration. The Supabase anon key is designed to be public;
# access is enforced by Supabase Auth, membership checks, and RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local-only identity used when Vite runs without Supabase.
# This is never used by a production build and is not an authorization source.
VITE_LOCAL_USER_ROLE=manager

# Server-only Zoho settings. Never rename these with a VITE_ prefix.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_CRM_ORG_ID=
ZOHO_CRM_ORG_SLUG=wildvisionltd

# Recommended for the eventual deployed server-based Zoho connection.
ZOHO_REFRESH_TOKEN=

# This Wild Vision account is in Zoho's EU data centre.
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_READ_SCOPE=ZohoCRM.modules.deals.READ

# Server-only automatic Sales OS access checks. At least one exact Zoho role or
# profile allowlist must be configured; stable IDs are preferred over names.
ZOHO_SALES_ACCESS_SCOPE=ZohoCRM.users.READ
ZOHO_SALES_ROLE_IDS=
ZOHO_SALES_ROLE_NAMES=
ZOHO_SALES_PROFILE_IDS=
ZOHO_SALES_PROFILE_NAMES=

# Optional local-only paths. Private files live outside the Vite website folder.
# Defaults to %USERPROFILE%\.wildvision-sales-os when left blank.
WV_LOCAL_DATA_DIR=
ZOHO_LOCAL_CREDENTIAL_FILE=

# Server-only Supabase values for the scheduled cache writer.
# Never rename the service role key with a VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Preferred replacement for a rotated/compromised legacy service_role key.
# Create an sb_secret_ key in Supabase and store it only as a server secret.
SALES_OS_SUPABASE_SECRET_KEY=

# One-time, server-side Sales OS Auth migration controls.
SALES_OS_INVITE_REDIRECT=
SALES_OS_EXPECTED_USER_COUNT=8
SALES_OS_EXPECTED_MANAGERS=
SALES_OS_EXPECTED_REPS=
SALES_OS_APPROVED_EXISTING_AUTH_USER_IDS=
SALES_OS_AUTH_MIGRATION_CONFIRM=

# A separate long random value used only by Supabase Cron to call the sync function.
HIT_LIST_SYNC_SECRET=

# Comma-separated browser origins allowed to read the hosted cache after Supabase Auth is enabled.
SALES_OS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://salesdashboard-gold.vercel.app
